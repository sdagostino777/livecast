{
  "name": "ndx-live",
  "private": true,
  "description": "NDX Live — live streaming platform (RTMP ingest → adaptive-bitrate HLS → public player)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "dev:api": "pnpm --filter @ndx-live/api dev",
    "dev:web": "pnpm --filter @ndx-live/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "cli": "pnpm --filter @ndx-live/api cli"
  }
}
