# Livecast — environment file for the API process.
# provision.sh generates the real one on the VPS; this file documents every
# variable and is what you copy for a local run.

NODE_ENV=development

# HTTP (Fastify). nginx proxies to this port in production.
PORT=4100
HOST=127.0.0.1

# All mutable state: SQLite DB, HLS output, recordings.
DATA_DIR=./data

# Public origin — used for page URLs, OBS instructions and the Origin check.
PUBLIC_URL=http://localhost:4100

# Host/port the operator's OBS points at (shown as a default in the panel).
INGEST_HOST=localhost
INGEST_PORT=1935

# MediaMTX control API and loopback RTMP address.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTMP_URL=rtmp://127.0.0.1:1935

# Credentials FFmpeg uses to read from MediaMTX (loopback only).
MEDIAMTX_READ_USER=
MEDIAMTX_READ_PASS=

# Credentials the broadcaster uses in OBS (shown in the panel, masked).
PUBLISH_USER=publisher
PUBLISH_PASS=

# Sessions: lifetime in hours; secure cookies require https at the edge.
SESSION_HOURS=12
COOKIE_SECURE=false

# Encoder and HLS tuning.
FFMPEG_BIN=ffmpeg
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=6
INGEST_WAIT_SECONDS=600
